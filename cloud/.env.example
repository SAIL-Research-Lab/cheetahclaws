# ── Required ────────────────────────────────────────────────────────────────
# Your domain (an A record must point at this server). Caddy gets HTTPS for it.
CC_DOMAIN=cloud.example.com
CC_PUBLIC_URL=https://cloud.example.com
# Generated by deploy.sh. Changing CC_SECRET signs everyone out;
# losing CC_FERNET_KEY makes stored user API keys unreadable.
CC_SECRET=
CC_FERNET_KEY=

# ── Our model service: upstream keys referenced by models.json (key_env) ───
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=

# ── Credits ─────────────────────────────────────────────────────────────────
CC_SIGNUP_CREDIT_USD=0.50
# Stripe (optional; without it top-ups are hidden and you grant credits by
# hand: docker compose exec gateway python -m ccloud.admin credit EMAIL 10)
CC_STRIPE_SECRET=
CC_STRIPE_WEBHOOK_SECRET=
CC_TOPUP_PACKS_USD=5,20,50

# ── Sandboxes (per user) ────────────────────────────────────────────────────
CC_SANDBOX_MEMORY=2g
CC_SANDBOX_CPUS=1.0
CC_SANDBOX_PIDS=512
CC_SANDBOX_IDLE_MINUTES=30
# Optional stronger isolation if gVisor is installed on the host:
# CC_SANDBOX_RUNTIME=runsc
CC_REGISTRATION_OPEN=true

# ── Mainland-China servers (set by deploy.sh --cn) ──────────────────────────
# PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
